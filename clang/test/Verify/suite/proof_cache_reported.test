# What a run reports does not depend on what an earlier run left in the
# proof cache.

# RUN: rm -rf %t && split-file %s %t

# A contract without a definition draws a warning, unless the run records
# contracts for other files to establish (--contracts-out). The two kinds of
# run keep records of their own: the warning is there after either.
# RUN: %cpp-verify --jobs=1 --proof-cache=%t/cache --contracts-out=%t/a.json %t/external.cpp -- 2>&1 | FileCheck %s --check-prefix=RECORDED
# RUN: not %cpp-verify --jobs=1 --proof-cache=%t/cache %t/external.cpp -- 2>&1 | FileCheck %s --check-prefix=PLAIN
# RUN: not %cpp-verify --jobs=1 --proof-cache=%t/cache %t/external.cpp -- 2>&1 | FileCheck %s --check-prefix=PLAIN
# RUN: %cpp-verify --jobs=1 --proof-cache=%t/cache --contracts-out=%t/b.json %t/external.cpp -- 2>&1 | FileCheck %s --check-prefix=RECORDED
# RUN: diff %t/a.json %t/b.json
# RECORDED-NOT: warning:
# RECORDED: Verified: use [backend=z3] {{.*}}[assumes=lib]
# PLAIN: external.cpp:3:5: warning: lib has a contract but no definition, so its callers are not verified
# PLAIN: Unresolved: use [backend=z3] {{.*}}[reason=callee.contract]
# PLAIN: Verified: own [backend=z3]

# The summary counts the replayed functions it reports, like its other
# counts: not the generated proofs of an inductive predicate's rules, nor
# the functions --function leaves out.
# RUN: %cpp-verify --jobs=1 --proof-cache=%t/count %t/counted.cpp -- 2>&1 | FileCheck %s --check-prefix=COLD
# RUN: %cpp-verify --jobs=1 --proof-cache=%t/count %t/counted.cpp -- 2>&1 | FileCheck %s --check-prefix=WARM
# RUN: %cpp-verify --jobs=1 --proof-cache=%t/count --function=half %t/counted.cpp -- 2>&1 | FileCheck %s --check-prefix=ONE
# RUN: %cpp-verify --jobs=1 --proof-cache=%t/count --diagnostics-format=json %t/counted.cpp -- > /dev/null 2>&1
# RUN: %cpp-verify --jobs=1 --proof-cache=%t/count --diagnostics-format=json %t/counted.cpp -- 2>/dev/null | FileCheck %s --check-prefix=JSON
# The report of a compilation counts them the same way.
# RUN: %clang_cc1 -std=c++17 -fverify-contracts -fverify-cache=%t/build -fverify-report=%t/cold.jsonl -emit-obj -o %t/x.o %t/counted.cpp
# RUN: %clang_cc1 -std=c++17 -fverify-contracts -fverify-cache=%t/build -fverify-report=%t/warm.jsonl -emit-obj -o %t/x.o %t/counted.cpp
# RUN: FileCheck %s --check-prefix=JSON < %t/warm.jsonl
# COLD: Summary: 3 verified in
# WARM: Summary: 3 verified, 3 reused from the proof cache in
# ONE: Summary: 1 verified, 1 reused from the proof cache in
# JSON: "reused":3,"schema":"cppverify.summary/1"

#--- external.cpp
#include <cppverify.h>
namespace cv = cppverify;
int lib(int x) cv::post(cv::result >= x);
int use(int x) cv::post(cv::result >= x) { return lib(x); }
int own(int x) cv::pre(x < 10) cv::post(cv::result == x + 1) { return x + 1; }

#--- counted.cpp
#include <cppverify.h>
namespace cv = cppverify;
cv::spec bool even(int n) cv::inductive { return n == 0 || even(n - 2); }
cv::proof void four() cv::post(even(4)) {}
int half(int x) cv::pre(0 <= x && x < 100) cv::post(cv::result * 2 <= x) { return x / 2; }
