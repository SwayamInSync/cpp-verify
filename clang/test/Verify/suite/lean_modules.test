# GOALS: {{^}}import CppVerify.Specs{{$}}
# GOALS-NOT: {{^}}import
# GOALS: {{^}}attribute [local instance] cppVerifyPropDecidable{{$}}
# GOALS: {{^}}def cppSpecBody_e086e9ab_fn_5f5a3374726969_1
# GOALS-PLUS: {{^}}import CppVerify.Specs{{$}}
# GOALS-PLUS: {{^}}def cppSpecBody_10bb8a86_fn_5f5a3374726969_1

# IMPORTS: {{^}}import CppVerify.Goals.cppverify_inc_c0810e{{$}}
