# REQUIRES: lean
#
# A Lean project has a module of goals for each function,
# CppVerify/Goals/<group>.lean, which imports CppVerify.Specs, where each spec
# the goals apply is declared once. A proof imports its function's goals,
# User, and Auto, so certification builds again only the proofs of a function
# whose goals changed.
#
# RUN: rm -rf %t && mkdir -p %t && cp %S/Inputs/lean_modules.cpp %t/m.cpp
# RUN: %cpp-verify --backend=lean --lean-project=%t/p %t/m.cpp -- 2>&1 | FileCheck %s --check-prefix=EXPORT
# RUN: FileCheck %s --input-file=%t/p/CppVerify/Generated.lean --check-prefix=GENERATED
# RUN: FileCheck %s --input-file=%t/p/CppVerify/Specs.lean --check-prefix=SPECS --implicit-check-not=opaque
# RUN: FileCheck %s --input-file=%t/p/CppVerify/Goals/cppverify_tri_zero_e086e9.lean --check-prefix=GOALS
# RUN: FileCheck %s --input-file=%t/p/CppVerify/Goals/cppverify_plus_tri_zero_10bb8a.lean --check-prefix=GOALS-PLUS
# RUN: FileCheck %s --input-file=%t/p/CppVerify/Proofs/cppverify_inc_c0810e/cppverify_inc_c0810e_postcondition_e4ef4574.lean --check-prefix=IMPORTS
# RUN: FileCheck %s --input-file=%t/p/CppVerify/User.lean --check-prefix=USER
# RUN: FileCheck %s --input-file=%t/p/CppVerify.lean --check-prefix=ROOT
#
# The two goal modules that apply tri are certified together, with proofs
# by hand of their postconditions in place of the automatic ones.
# RUN: cp %S/Inputs/lean_modules_tri_zero.lean %t/p/CppVerify/Proofs/cppverify_tri_zero_e086e9/cppverify_tri_zero_e086e9_postcondition_44e49d34.lean
# RUN: cp %S/Inputs/lean_modules_plus_tri_zero.lean %t/p/CppVerify/Proofs/cppverify_plus_tri_zero_10bb8a/cppverify_plus_tri_zero_10bb8a_postcondition_8b45419c.lean
# RUN: %cpp-verify --backend=lean --lean-project=%t/p --lean-certify %t/m.cpp -- 2>&1 | FileCheck %s --check-prefix=CERTIFY
#
# A run of the same source writes no file. The two proofs by hand are not
# cppverify_auto's.
# RUN: touch %t/same
# RUN: %cpp-verify --backend=lean --lean-project=%t/p %t/m.cpp -- 2>&1 | FileCheck %s --check-prefix=EXPORT-AGAIN
# RUN: find %t/p -newer %t/same -type f -not -path '*/.lake/*' | count 0
#
# A change to dbl builds dbl's goal module and proofs again, and the module
# that imports every goal module; nothing else.
# RUN: touch %t/before
# RUN: sed 's/cppverify::result == 2 \* x/cppverify::result == x + x/' %S/Inputs/lean_modules.cpp > %t/m.cpp
# RUN: %cpp-verify --backend=lean --lean-project=%t/p --lean-certify %t/m.cpp -- 2>&1 | FileCheck %s --check-prefix=CERTIFY
# RUN: cd %t/p/.lake/build/lib/lean && find CppVerify -name '*.olean' -newer %t/before | env LC_ALL=C sort | FileCheck %s --check-prefix=REBUILT --implicit-check-not=olean
#
# `lake build` builds every proof. Run in the project, elan selects its
# toolchain.
# RUN: cd %t/p && lake build 2>&1 | FileCheck %s --check-prefix=LAKE
#
# A function that is gone takes its goal module with it.
# RUN: sed -e 's/cppverify::result == 2 \* x/cppverify::result == x + x/' -e '/^int inc(/,/^}/d' %S/Inputs/lean_modules.cpp > %t/m.cpp
# RUN: %cpp-verify --backend=lean --lean-project=%t/p %t/m.cpp -- 2>&1 | FileCheck %s --check-prefix=WITHOUT-INC
# RUN: not test -e %t/p/CppVerify/Goals/cppverify_inc_c0810e.lean
#
# A project of an earlier release, whose User imports Generated, still
# certifies: each proof then depends on every goal module.
# RUN: printf 'import CppVerify.Generated\n' > %t/p/CppVerify/User.lean
# RUN: %cpp-verify --backend=lean --lean-project=%t/p --lean-certify %t/m.cpp -- 2>&1 | FileCheck %s --check-prefix=OLD-USER
#
# A fallback run writes the goal modules of the functions it exports and no
# other, since Specs then declares only the specs those apply. Here the
# solver verifies every function: no goal module stays, and every proof does.
# RUN: %cpp-verify --lean-fallback=%t/p %t/m.cpp -- 2>&1 | FileCheck %s --check-prefix=FALLBACK
# RUN: not test -e %t/p/CppVerify/Goals/cppverify_tri_zero_e086e9.lean
# RUN: test -f %t/p/CppVerify/Proofs/cppverify_tri_zero_e086e9/cppverify_tri_zero_e086e9_postcondition_44e49d34.lean
# RUN: cd %t/p && lake build 2>&1 | FileCheck %s --check-prefix=LAKE

# EXPORT: Exported: decreases: tri (cppverify_auto proved 1 of 1 goals)
# EXPORT-NEXT: Exported: lean obligation: inc (cppverify_auto proved 3 of 3 goals)
# EXPORT-NEXT: Exported: lean obligation: dbl (cppverify_auto proved 3 of 3 goals)
# EXPORT-NEXT: Exported: lean obligation: tri_zero (cppverify_auto proved 2 of 2 goals)
# EXPORT-NEXT: Exported: lean obligation: plus_tri_zero (cppverify_auto proved 2 of 2 goals)

# EXPORT-AGAIN: Exported: lean obligation: tri_zero (cppverify_auto proved 1 of 2 goals)
# EXPORT-AGAIN-NEXT: Exported: lean obligation: plus_tri_zero (cppverify_auto proved 1 of 2 goals)

