SARIF:      "text": "place parentheses around the assignment to silence this warning"
SARIF:      "ruleId": "frontend",
A proof passes.
SARIF:      "kind": "pass",
SARIF-NEXT: "level": "none",
SARIF:      "name": "inc"
SARIF:      "text": "Verified: inc [backend=z3]"
SARIF:      "ruleId": "verified",
