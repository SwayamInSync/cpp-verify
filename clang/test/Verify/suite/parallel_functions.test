# Functions are verified at once on one pool of workers, and their
# obligations on the same pool. Everything published is what one job
# publishes: verdicts, the steps that relate functions (spec termination,
# callee contracts, unverified callers), dumps, and archive records.
#
# RUN: not %cpp-verify --jobs=1 %S/Inputs/parallel_functions.cpp -- > %t.serial 2>&1
# RUN: not %cpp-verify --jobs=4 %S/Inputs/parallel_functions.cpp -- > %t.parallel 2>&1
# The summary's time may differ between runs.
# RUN: sed 's/ in [0-9.]* s$//' %t.serial > %t.serial.untimed
# RUN: sed 's/ in [0-9.]* s$//' %t.parallel > %t.parallel.untimed
# RUN: diff %t.serial.untimed %t.parallel.untimed
# RUN: FileCheck %s < %t.parallel
#
# RUN: not %cpp-verify --jobs=1 --diagnostics-format=json \
# RUN:   %S/Inputs/parallel_functions.cpp -- > %t.serial.json 2>&1
# RUN: not %cpp-verify --jobs=4 --diagnostics-format=json \
# RUN:   %S/Inputs/parallel_functions.cpp -- > %t.parallel.json 2>&1
# RUN: diff %t.serial.json %t.parallel.json
#
# RUN: not %cpp-verify --jobs=1 --obligation-out=%t.serial.cpv \
# RUN:   %S/Inputs/parallel_functions.cpp -- > /dev/null 2>&1
# RUN: not %cpp-verify --jobs=4 --obligation-out=%t.parallel.cpv \
# RUN:   %S/Inputs/parallel_functions.cpp -- > /dev/null 2>&1
# RUN: cmp %t.serial.cpv %t.parallel.cpv
#
# RUN: %cpp-verify --jobs=1 --lower-only --dump-ir=all \
# RUN:   %S/Inputs/parallel_functions.cpp -- > %t.serial.ir 2>&1
# RUN: %cpp-verify --jobs=4 --lower-only --dump-ir=all \
# RUN:   %S/Inputs/parallel_functions.cpp -- > %t.parallel.ir 2>&1
# RUN: sed 's/ in [0-9.]* s$//' %t.serial.ir > %t.serial.ir.untimed
# RUN: sed 's/ in [0-9.]* s$//' %t.parallel.ir > %t.parallel.ir.untimed
# RUN: cmp %t.serial.ir.untimed %t.parallel.ir.untimed
#
# One budget for all queries of a function.
# RUN: not %cpp-verify --jobs=4 --function-timeout=1 \
# RUN:   %S/Inputs/parallel_functions.cpp -- 2>&1 | FileCheck %s --check-prefix=BUDGET

# CHECK: Verified: spec decreases: climb
# CHECK-NEXT: error: spec decreases failed: diverge
# CHECK: Verified: climb_zero [backend=z3]
# CHECK-NEXT: Unresolved: diverge_zero [backend=z3] [reason=spec.termination]
# CHECK-NEXT: error: verification failed: off_by_one
# CHECK: Unresolved: relies_on_off_by_one [backend=z3] [reason=callee.contract]
# CHECK-NEXT: Verified: positive_identity [backend=z3] (its precondition is assumed, not checked, at calls from unverified unchecked_caller)
# CHECK-NEXT: Verified: sum_to [backend=z3]
# CHECK-NEXT: Verified: clear [backend=z3]
# CHECK-NEXT: error: verification failed: overflow [overflow]
# CHECK: :72:3: error: verification failed: two_failures [assertion]
# CHECK: Verified: both_ways [backend=z3]

# BUDGET: Unresolved: sum_to [backend=z3] [reason=solver.timeout]
