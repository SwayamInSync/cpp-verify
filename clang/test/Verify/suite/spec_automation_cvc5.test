# REQUIRES: cvc5
# cvc5 computes closed applications, checks counterexamples, and proves the
# bounded and inductive goals by induction on their exact arithmetic. Whether
# it settles the nonlinear lemma, its machine-arithmetic use, and the
# accumulator depends on its version (1.1 does not, 1.4 settles the lemma), so
# those may be proved or unresolved, never failed.
# RUN: not %cpp-verify --backend=cvc5 %S/spec_automation.cpp -- 2>&1 \
# RUN:   | FileCheck %s

# CHECK-DAG: Verified: computed [backend=cvc5]
# CHECK-DAG: verification failed: computed_wrong {{.*}}[backend=cvc5]
# CHECK-DAG: Verified: bounded [backend=cvc5]
# CHECK-DAG: verification failed: bounded_wrong {{.*}}[backend=cvc5] [reason=counterexample]
# CHECK-DAG: Verified: inductive [backend=cvc5]
# CHECK-DAG: {{Verified|Unresolved}}: accumulated [backend=cvc5]
# CHECK-DAG: Verified: accumulate_sum [backend=cvc5]
# CHECK-DAG: Verified: accumulated_by_lemma [backend=cvc5]
# CHECK-DAG: {{Verified|Unresolved}}: sum_closed [backend=cvc5]
# CHECK-DAG: {{Verified|Unresolved}}: gauss [backend=cvc5]
# CHECK-DAG: {{Verified|Unresolved}}: steps [backend=cvc5]
