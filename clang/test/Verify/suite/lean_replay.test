# NO-PROJECT: error: --lean-certify, --lean-prune-stale, and --no-lean-auto require --lean-project
# NO-FALLBACK: error: --lean-fallback applies to source verification; archive replay writes a Lean project with --lean-project
# BOTH: error: --lean-project cannot be combined with --lean-out
# Z3: error: --lean-project requires --backend=lean
