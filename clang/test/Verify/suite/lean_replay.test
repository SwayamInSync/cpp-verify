# REQUIRES: lean
#
# An archive replays into a Lean project as its source exports: the same
# goals, specs, and proof files, so a proof written for the source certifies
# the archive's goal. Replay checks each module alone, as with a solver.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: %cpp-verify --lower-only --obligation-out=%t/a.cpv %S/Inputs/lean_replay.cpp --
# RUN: %cpp-verify --backend=lean --lean-project=%t/src %S/Inputs/lean_replay.cpp -- 2>&1 | FileCheck %s --check-prefix=SOURCE
# RUN: %cpp-verify --obligation-in=%t/a.cpv --lean-project=%t/rep 2>&1 | FileCheck %s --check-prefix=REPLAY
# RUN: diff -r %t/src/CppVerify/Goals %t/rep/CppVerify/Goals
# RUN: diff %t/src/CppVerify/Specs.lean %t/rep/CppVerify/Specs.lean
# RUN: diff -r %t/src/CppVerify/Proofs %t/rep/CppVerify/Proofs
# RUN: FileCheck %s --input-file=%t/rep/CppVerify/Specs.lean --check-prefix=SPECS
# RUN: FileCheck %s --input-file=%t/rep/CppVerify/Goals/cppverify_inc_c0810e.lean --check-prefix=READABLE
#
# RUN: cp %S/Inputs/lean_spec_definitions_tri_nonneg.lean %t/rep/CppVerify/Proofs/cppverify_tri_nonneg_42a030/cppverify_tri_nonneg_42a030_postcondition_053b1980.lean
# RUN: %cpp-verify --obligation-in=%t/a.cpv --lean-project=%t/rep --lean-certify 2>&1 | FileCheck %s --check-prefix=CERTIFY
# RUN: %cpp-verify --obligation-in=%t/a.cpv --lean-project=%t/rep --diagnostics-format=json | FileCheck %s --check-prefix=JSON
#
# A record of schema 2 has no measures, and no names for a goal's
# assumptions: tri is opaque, and a readable goal names no hypothesis.
# RUN: %python %S/Inputs/mutate_obligation_archive.py schema-v2 %t/a.cpv %t/v2.cpv
# RUN: %cpp-verify --obligation-in=%t/v2.cpv --lean-project=%t/v2 2>&1 | FileCheck %s --check-prefix=REPLAY
# RUN: FileCheck %s --input-file=%t/v2/CppVerify/Specs.lean --check-prefix=SPECS-V2
# RUN: FileCheck %s --input-file=%t/v2/CppVerify/Goals/cppverify_inc_c0810e.lean --check-prefix=READABLE-V2
#
# A bounded module states its bound with its goals. Every goal of sum_small
# certifies, its unwinding included; count_up's unwinding does not, since
# its loop may run longer, and the rest shows it safe within the bound.
# RUN: not %cpp-verify --backend=bmc --unroll=3 --obligation-out=%t/b.cpv %S/Inputs/lean_replay_loops.cpp --
# RUN: %cpp-verify --obligation-in=%t/b.cpv --backend=lean --lean-out=%t/b.lean 2>&1 | FileCheck %s --check-prefix=BOUNDED-EXPORT
# RUN: FileCheck %s --input-file=%t/b.lean --check-prefix=BOUND
# RUN: not %cpp-verify --obligation-in=%t/b.cpv --lean-project=%t/b --lean-certify 2>&1 | FileCheck %s --check-prefix=BOUNDED
#
# A replay moves and keeps proofs as a source run does: the proof of
# tri_nonneg, which no goal of the bounded archive has, is kept in Stale/.
# RUN: %cpp-verify --obligation-in=%t/b.cpv --lean-project=%t/rep 2>&1 | FileCheck %s --check-prefix=STALE
# RUN: test -f %t/rep/Stale/Proofs/cppverify_tri_nonneg_42a030/cppverify_tri_nonneg_42a030_postcondition_053b1980.lean
# Its goal back, it takes the proof back, which a JSON run says as JSON.
# RUN: %cpp-verify --obligation-in=%t/a.cpv --lean-project=%t/rep --diagnostics-format=json | FileCheck %s --check-prefix=BACK
#
# RUN: not %cpp-verify --obligation-in=%t/a.cpv --lean-certify 2>&1 | FileCheck %s --check-prefix=NO-PROJECT
# RUN: not %cpp-verify --obligation-in=%t/a.cpv --lean-fallback=%t/f 2>&1 | FileCheck %s --check-prefix=NO-FALLBACK
# RUN: not %cpp-verify --obligation-in=%t/a.cpv --lean-project=%t/x --lean-out=%t/x.lean 2>&1 | FileCheck %s --check-prefix=BOTH
# RUN: not %cpp-verify --obligation-in=%t/a.cpv --backend=z3 --lean-project=%t/x 2>&1 | FileCheck %s --check-prefix=Z3

# SOURCE: Exported: decreases: tri (cppverify_auto proved 1 of 1 goals)
# SOURCE-NEXT: Exported: lean obligation: tri_nonneg (cppverify_auto proved 1 of 2 goals)
# SOURCE: Exported: decreases: down (cppverify_auto proved 1 of 1 goals)
# SOURCE-NEXT: Exported: lean obligation: down_zero (cppverify_auto proved 2 of 2 goals)
# SOURCE-NEXT: Exported: lean obligation: inc (cppverify_auto proved 3 of 3 goals)

# REPLAY: Exported: lean obligation: tri.decreases (cppverify_auto proved 1 of 1 goals) [backend=lean] [semantic-hash=sha256:{{[0-9a-f]+}}]
# REPLAY-NEXT: Exported: lean obligation: tri_nonneg (cppverify_auto proved 1 of 2 goals) [backend=lean]
# REPLAY-NEXT: Exported: lean obligation: down.decreases (cppverify_auto proved 1 of 1 goals) [backend=lean]
# REPLAY-NEXT: Exported: lean obligation: down_zero (cppverify_auto proved 2 of 2 goals) [backend=lean]
# REPLAY-NEXT: Exported: lean obligation: inc (cppverify_auto proved 3 of 3 goals) [backend=lean]

# The archive keeps tri's measure, and, for down's, the spec it applies.
# SPECS: {{^}}def cppSpec_fn_5f5a3374726969 (n : Int) : Int :={{$}}
# SPECS: {{^}}termination_by ((n) + 1).toNat{{$}}
# SPECS: {{^}}def cppSpec_fn_5f5a3473697a6569 (n : Int) : Int :={{$}}

# READABLE: (h_pre_1 : (cppBvSlt x_0 (BitVec.ofInt 32 (100)))) →

