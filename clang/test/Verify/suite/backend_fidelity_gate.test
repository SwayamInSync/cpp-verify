# REQUIRES: cvc5, lean
#
# RUN: rm -rf %t
# RUN: %python %S/Inputs/run_backend_fidelity.py \
# RUN:   --cpp-verify=%cpp-verify \
# RUN:   --source=%S/Inputs/backend_fidelity_matrix.cpp \
# RUN:   --recommends=%S/Inputs/backend_fidelity_recommends.cpp \
# RUN:   --work-dir=%t | FileCheck %s
#
# CHECK: PASS: canonical feature and operator matrix
# CHECK-NEXT: PASS: automated verdict and conservative-unknown matrix
# CHECK-NEXT: PASS: source diagnostic identity and parallel determinism
# CHECK-NEXT: PASS: canonical and incremental-BMC archive replay
# CHECK-NEXT: PASS: Lean theorem, hash, replay, and kernel-export identity
# CHECK-NEXT: PASS: recommends exclusion from BMC and Lean replay artifacts
