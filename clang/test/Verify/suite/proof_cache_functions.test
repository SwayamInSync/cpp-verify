# A function all of whose verdicts are proofs is recorded in the proof cache
# under a key of everything its verification read, and a later run replays
# the record before it lowers anything. Each edit below re-verifies exactly
# the functions it can affect; a function that fails is verified every time.

# RUN: rm -rf %t && split-file %s %t

# Nothing recorded yet, then everything proved is replayed.
# RUN: not %cpp-verify --jobs=1 --time-report --proof-cache=%t/cache %t/base.cpp -- > %t/cold.txt 2>&1
# RUN: FileCheck %s --check-prefix=COLD < %t/cold.txt
# RUN: not %cpp-verify --jobs=1 --time-report --proof-cache=%t/cache %t/base.cpp -- > %t/warm.txt 2>&1
# RUN: FileCheck %s --check-prefix=WARM < %t/warm.txt
# COLD-NOT: (proof cache)
# COLD: Summary: 4 verified, 1 failed in
# WARM-DAG: Verified: first [backend=z3] [cache=
# WARM-DAG: Verified: clamp [backend=z3] [cache=
# WARM-DAG: Verified: user [backend=z3] [cache=
# WARM-DAG: Verified: lemma_twice [backend=z3]
# WARM-DAG: error: verification failed: wrong [postcondition]
# WARM-DAG: {{ first \(proof cache\)$}}
# WARM-DAG: {{ clamp \(proof cache\)$}}
# WARM-DAG: {{ user \(proof cache\)$}}
# WARM-DAG: {{ wrong$}}
# WARM: Summary: 4 verified, 1 failed, 3 reused from the proof cache in

# The verdicts are those of a run without a cache.
# RUN: not %cpp-verify --jobs=1 %t/base.cpp -- > %t/none.txt 2>&1
# RUN: not %cpp-verify --jobs=1 --proof-cache=%t/cache %t/base.cpp -- > %t/again.txt 2>&1
# RUN: sed -E 's/ in [0-9.]+ s//; s/ \[cache=[0-9]+\/[0-9]+\]//g; s/, [0-9]+ reused from the proof cache//' %t/again.txt > %t/again.plain
# RUN: sed -E 's/ in [0-9.]+ s//' %t/none.txt > %t/none.plain
# RUN: diff %t/none.plain %t/again.plain

# Code moved, a comment, and another function added: every record is found.
# RUN: not %cpp-verify --jobs=1 --time-report --proof-cache=%t/cache %t/moved.cpp -- 2>&1 | FileCheck %s --check-prefix=MOVED
# MOVED-DAG: {{ first \(proof cache\)$}}
# MOVED-DAG: {{ clamp \(proof cache\)$}}
# MOVED-DAG: {{ user \(proof cache\)$}}
# MOVED-DAG: {{ added$}}

# A callee's body changed, its contract kept: the callee is verified again,
# its caller is not.
# RUN: not %cpp-verify --jobs=1 --time-report --proof-cache=%t/cache %t/body.cpp -- 2>&1 | FileCheck %s --check-prefix=BODY
# BODY-DAG: {{ clamp$}}
# BODY-DAG: {{ user \(proof cache\)$}}
# BODY-DAG: {{ first \(proof cache\)$}}

# A callee's contract changed: its caller is verified again too.
# RUN: not %cpp-verify --jobs=1 --time-report --proof-cache=%t/cache %t/contract.cpp -- 2>&1 | FileCheck %s --check-prefix=CONTRACT
# CONTRACT-DAG: {{ clamp$}}
# CONTRACT-DAG: {{ user$}}
# CONTRACT-DAG: {{ first \(proof cache\)$}}

# A spec's body changed: what applies it is verified again, and now fails.
# RUN: not %cpp-verify --jobs=1 --time-report --proof-cache=%t/cache %t/spec.cpp -- 2>&1 | FileCheck %s --check-prefix=SPEC
# SPEC-DAG: error: verification failed: user [postcondition]
# SPEC-DAG: {{ user$}}
# SPEC-DAG: {{ clamp \(proof cache\)$}}
# SPEC-DAG: {{ first \(proof cache\)$}}

# A field added to a record: the functions over the record are verified
# again.
# RUN: not %cpp-verify --jobs=1 --time-report --proof-cache=%t/cache %t/field.cpp -- 2>&1 | FileCheck %s --check-prefix=FIELD
# FIELD-DAG: {{ first$}}
# FIELD-DAG: {{ clamp \(proof cache\)$}}
# FIELD-DAG: {{ user \(proof cache\)$}}

# A constant changed: the function that uses it is verified again.
# RUN: not %cpp-verify --jobs=1 --time-report --proof-cache=%t/cache %t/constant.cpp -- 2>&1 | FileCheck %s --check-prefix=CONSTANT
# CONSTANT-DAG: error: verification failed: user [precondition]
# CONSTANT-DAG: {{ user$}}
# CONSTANT-DAG: {{ clamp \(proof cache\)$}}

# An option that changes what is proved has records of its own.
# RUN: not %cpp-verify --jobs=1 --time-report --no-check-ub --proof-cache=%t/cache %t/base.cpp -- 2>&1 | FileCheck %s --check-prefix=OPTION
# OPTION-NOT: (proof cache)

# A limit does not: a proof holds under any.
# RUN: not %cpp-verify --jobs=1 --time-report --timeout=30000 --proof-cache=%t/cache %t/base.cpp -- 2>&1 | FileCheck %s --check-prefix=LIMIT
# LIMIT-DAG: {{ user \(proof cache\)$}}

# --proof-cache-check verifies all the same and finds the records right.
# RUN: not %cpp-verify --jobs=1 --time-report --proof-cache-check --proof-cache=%t/cache %t/base.cpp -- 2>&1 | FileCheck %s --check-prefix=CHECK
# CHECK-NOT: differs from its verification
# CHECK-NOT: (proof cache)
# CHECK: Summary: 4 verified, 1 failed in

# A record that is not what was written is not used.
# RUN: rm -rf %t/one && not %cpp-verify --jobs=1 --proof-cache=%t/one %t/base.cpp -- > /dev/null 2>&1
# RUN: %python -c "import glob, sys; [open(p, 'ab').write(b'x') for p in glob.glob(sys.argv[1] + '/llvmcache-cppverify-*') if open(p, 'rb').read().startswith(b'cppverify.function-results/')]" %t/one
# RUN: not %cpp-verify --jobs=1 --time-report --proof-cache=%t/one %t/base.cpp -- 2>&1 | FileCheck %s --check-prefix=CORRUPT
# CORRUPT-NOT: (proof cache)
# CORRUPT: Summary: 4 verified, 1 failed

# That run wrote the records again.
# RUN: not %cpp-verify --jobs=1 --proof-cache=%t/one %t/base.cpp -- 2>&1 | FileCheck %s --check-prefix=REPAIRED
# REPAIRED: Summary: 4 verified, 1 failed, 3 reused from the proof cache in

#--- base.cpp
#include <cppverify.h>
namespace cv = cppverify;

const int Limit = 1000;

cv::spec int twice(int x) { return 2 * x; }

struct Pair { int a; int b; };

int first(const Pair &p)
  cv::post(cv::result == p.a)
{
  return p.a;
}

int clamp(int x, int lo, int hi)
  cv::pre(lo <= hi)
  cv::post(cv::result == (x < lo ? lo : x > hi ? hi : x))
{
  if (x < lo)
    return lo;
  if (x > hi)
    return hi;
  return x;
}

int user(int x)
  cv::pre(x >= 0 && x < 100)
  cv::post(cv::result == twice(x))
{
  return clamp(x + x, 0, Limit);
}

cv::proof void lemma_twice(int x)
  cv::pre(x >= 0 && x < 100)
  cv::post(twice(x) >= x)
{
}

int wrong(int x)
  cv::pre(x < 100)
  cv::post(cv::result > x + 1)
{
  return x + 1;
}

#--- moved.cpp
#include <cppverify.h>
namespace cv = cppverify;

// Everything below is where it was not.

int added(int q)
  cv::post(cv::result == q)
{
  return q;
}

const int Limit = 1000;

cv::spec int twice(int x) { return 2 * x; }

struct Pair { int a; int b; };

int clamp(int x, int lo, int hi)
  cv::pre(lo <= hi)
  cv::post(cv::result == (x < lo ? lo : x > hi ? hi : x))
{
  if (x < lo)
    return lo;
  if (x > hi)
    return hi;
  return x;
}

int first(const Pair &p)
  cv::post(cv::result == p.a)
{
  return p.a;
}


int user(int x)
  cv::pre(x >= 0 && x < 100)
  cv::post(cv::result == twice(x))
{
  return clamp(x + x, 0, Limit);
}

cv::proof void lemma_twice(int x)
  cv::pre(x >= 0 && x < 100)
  cv::post(twice(x) >= x)
{
}

int wrong(int x)
  cv::pre(x < 100)
  cv::post(cv::result > x + 1)
{
  return x + 1;
}

