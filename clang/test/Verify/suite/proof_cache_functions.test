#include <cppverify.h>
namespace cv = cppverify;

const int Limit = 1000;

cv::spec int twice(int x) { return 2 * x; }

struct Pair { int a; int b; };

int first(const Pair &p)
  cv::post(cv::result == p.a)
{
  return p.a;
}

int clamp(int x, int lo, int hi)
  cv::pre(lo <= hi)
  cv::post(cv::result == (x < lo ? lo : x > hi ? hi : x))
{
  return x < lo ? lo : x > hi ? hi : x;
}

int user(int x)
  cv::pre(x >= 0 && x < 100)
  cv::post(cv::result == twice(x))
{
  return clamp(x + x, 0, Limit);
}

cv::proof void lemma_twice(int x)
  cv::pre(x >= 0 && x < 100)
  cv::post(twice(x) >= x)
{
}

