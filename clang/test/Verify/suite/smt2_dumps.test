# --dump-smt2 writes each query a solver checks as a script the solver
# replays on its own: the options cpp-verify sets, the query, the check, and
# the answer cpp-verify got. Names depend on the query alone.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: not %cpp-verify --jobs=1 --dump-smt2=%t/z3 %S/Inputs/smt2_dumps.cpp -- 2>&1 \
# RUN:   | FileCheck %s --check-prefix=VERDICTS
# RUN: %python %S/Inputs/replay_smt2.py --list %t/z3 > %t/z3.files
# RUN: FileCheck %s --check-prefix=FILES --input-file=%t/z3.files
# RUN: %python -c "import os, sys; print(sorted(len(os.listdir(os.path.join(sys.argv[1], d))) > 0 for d in os.listdir(sys.argv[1]) if d.startswith('half-')))" %t/z3 \
# RUN:   | FileCheck %s --check-prefix=OVERLOADS
# RUN: cat %t/z3/clamp-*/postcondition-16-23.z3-*.smt2 | FileCheck %s --check-prefix=FAILED
# RUN: cat %t/z3/second-*/whole.z3-*.smt2 | FileCheck %s --check-prefix=QUANTIFIED
#
# A second run writes the same files.
# RUN: not %cpp-verify --jobs=1 --dump-smt2=%t/again %S/Inputs/smt2_dumps.cpp -- > /dev/null 2>&1
# RUN: %python %S/Inputs/replay_smt2.py --list %t/again > %t/again.files
# RUN: diff %t/z3.files %t/again.files
#
# Each script replays in Z3's own shell with the answer cpp-verify got, and
# in cvc5 likewise.
# RUN: %if z3-shell %{ %python %S/Inputs/replay_smt2.py z3 %cppverify-z3 %t/z3 | FileCheck %s --check-prefix=Z3 %}
# RUN: %if cvc5 %{ not %cpp-verify --jobs=1 --backend=cvc5 --dump-smt2=%t/cvc5 %S/Inputs/smt2_dumps.cpp -- > /dev/null 2>&1 %}
# RUN: %if cvc5 %{ cat %t/cvc5/clamp-*/postcondition-16-23.cvc5-*.smt2 | FileCheck %s --check-prefix=CVC5 %}
# RUN: %if cvc5 %{ %python %S/Inputs/replay_smt2.py cvc5 cvc5 %t/cvc5 | FileCheck %s --check-prefix=CVC5-REPLAY %}
#
# A solver that has checked before prints the model converter its
# preprocessing left, `model-add` of symbols it never declares; the dump of
# a later check on it leaves that out.
# RUN: not %cpp-verify --jobs=1 --dump-smt2=%t/narrowed %S/Inputs/smt2_dumps_narrowed.cpp -- > /dev/null 2>&1
# RUN: cat %t/narrowed/first_positive_bitwise-*/postcondition-*.smt2 \
# RUN:   | FileCheck %s --check-prefix=NARROWED --implicit-check-not=model-add
#
# An archive's replay writes the queries it checks.
# RUN: not %cpp-verify --jobs=1 --obligation-out=%t/q.cpv %S/Inputs/smt2_dumps.cpp -- > /dev/null 2>&1
# RUN: not %cpp-verify --jobs=1 --obligation-in=%t/q.cpv --dump-smt2=%t/replay > /dev/null 2>&1
# RUN: %python %S/Inputs/replay_smt2.py --list %t/replay | FileCheck %s --check-prefix=REPLAY
#
# A directory that cannot be written is a warning; the verdicts stand.
# RUN: touch %t/plain
# RUN: not %cpp-verify --jobs=1 --dump-smt2=%t/plain %S/Inputs/smt2_dumps.cpp -- 2>&1 \
# RUN:   | FileCheck %s --check-prefix=UNWRITABLE

