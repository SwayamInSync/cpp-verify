# REQUIRES: lean
#
# Certification holds against a proof author in bad faith. It checks the
# compiled modules with a program that elaborates none of the user's source:
# the kernel replays every module of the project a proof imports, the proof
# must state its goal, and it may depend on no axiom but Lean's foundations.
# Each function is certified on its own goals.
#
# RUN: rm -rf %t && mkdir -p %t
# RUN: %cpp-verify --backend=lean --lean-project=%t/base %S/Inputs/lean_certifier.cpp -- 2>&1 | FileCheck %s --check-prefix=EXPORT
# RUN: cp %S/Inputs/lean_certifier_proofs/cppverify_fine_* %t/base/CppVerify/Proofs/cppverify_fine_52006a/
# RUN: cp %S/Inputs/lean_certifier_proofs/cppverify_one_* %t/base/CppVerify/Proofs/cppverify_one_99bcee/
#
# The function whose proofs check is certified, whatever the other's are.
# RUN: cp -r %t/base %t/sorry
# RUN: not %cpp-verify --backend=lean --lean-project=%t/sorry --lean-certify %S/Inputs/lean_certifier.cpp -- 2>&1 | FileCheck %s --check-prefix=SORRY
#
# Macros of the user's that rewrite the checks of Check.lean, and a proof of
# True for the false postcondition.
# RUN: cp -r %t/base %t/rewritten
# RUN: cp %S/Inputs/lean_certifier_proofs/rewritten/User.lean %t/rewritten/CppVerify/
# RUN: cp %S/Inputs/lean_certifier_proofs/rewritten/cppverify_one_* %t/rewritten/CppVerify/Proofs/cppverify_one_99bcee/
# RUN: not %cpp-verify --backend=lean --lean-project=%t/rewritten --lean-certify %S/Inputs/lean_certifier.cpp -- 2>&1 | FileCheck %s --check-prefix=REWRITTEN
#
# A theorem of the goal added without the kernel, in the proof module, then in
# a module of the project the proof imports.
# RUN: cp -r %t/base %t/unchecked
# RUN: cp %S/Inputs/lean_certifier_proofs/unchecked/cppverify_one_* %t/unchecked/CppVerify/Proofs/cppverify_one_99bcee/
# RUN: not %cpp-verify --backend=lean --lean-project=%t/unchecked --lean-certify %S/Inputs/lean_certifier.cpp -- 2>&1 | FileCheck %s --check-prefix=UNCHECKED
# RUN: cp -r %t/base %t/imported
# RUN: cp %S/Inputs/lean_certifier_proofs/imported/Lemmas.lean %t/imported/CppVerify/
# RUN: cp %S/Inputs/lean_certifier_proofs/imported/cppverify_one_* %t/imported/CppVerify/Proofs/cppverify_one_99bcee/
# RUN: cd %t/imported && lake build CppVerify.Lemmas
# RUN: not %cpp-verify --backend=lean --lean-project=%t/imported --lean-certify %S/Inputs/lean_certifier.cpp -- 2>&1 | FileCheck %s --check-prefix=IMPORTED
#
# A goal of the same name defined in the proof's own file.
# RUN: cp -r %t/base %t/shadowed
# RUN: cp %S/Inputs/lean_certifier_proofs/shadowed/cppverify_one_* %t/shadowed/CppVerify/Proofs/cppverify_one_99bcee/
# RUN: not %cpp-verify --backend=lean --lean-project=%t/shadowed --lean-certify %S/Inputs/lean_certifier.cpp -- 2>&1 | FileCheck %s --check-prefix=SHADOWED
#
# An axiom behind a lemma.
# RUN: cp -r %t/base %t/hidden
# RUN: cp %S/Inputs/lean_certifier_proofs/hidden/cppverify_one_* %t/hidden/CppVerify/Proofs/cppverify_one_99bcee/
# RUN: not %cpp-verify --backend=lean --lean-project=%t/hidden --lean-certify %S/Inputs/lean_certifier.cpp -- 2>&1 | FileCheck %s --check-prefix=HIDDEN

